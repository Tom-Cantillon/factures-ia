# Copy to .env and fill in. .env is git-ignored: never commit real credentials.

# --- S3 bucket with the invoices (Hyperfluid) ---
S3_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
S3_BUCKET=factures
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- OCR: LightOnOCR-3 on Hyperfluid (see the model page for the endpoint) ---
OCR_ENDPOINT_URL=
OCR_API_KEY=
OCR_MODEL=lightonocr-3-1b-test

# --- Agent LLM (swappable by config) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
